# Frontend env vars consumed by Vite at build time.
# In Lovable cloud preview these are unset and the app falls back to the
# cloud Supabase project. On your VPS, install.sh writes the real values
# pointing at the self-hosted Supabase stack.

VITE_SUPABASE_URL=https://your-vps-domain-or-ip:8000
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-jwt-here
VITE_SUPABASE_PROJECT_ID=shahifa-self-hosted
